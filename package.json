{
  "name": "markora",
  "version": "0.2.3-alpha",
  "private": true,
  "description": "Markora — Markdown editor (Rust + egui + WebView2). UI built with Tailwind CSS v4.",
  "scripts": {
    "build:ui": "node tools/build-ui.cjs",
    "build:ui:watch": "node tools/build-ui.cjs --watch",
    "test": "node --test tools/test-search.cjs tools/test-images.cjs && cargo test",
    "test:search": "node --test tools/test-search.cjs",
    "test:find": "node tools/smoke-find.cjs",
    "test:position": "node tools/smoke-position.cjs",
    "test:ui": "node tools/verify-ui.cjs && node tools/smoke-sidebar.cjs && node tools/smoke-native.cjs && node tools/smoke-safety.cjs && node tools/smoke-find.cjs && node tools/smoke-position.cjs && node tools/smoke-images.cjs --dom",
    "test:sidebar": "node tools/smoke-sidebar.cjs",
    "test:images": "node tools/smoke-images.cjs --dom",
    "test:images:desktop": "node tools/smoke-images.cjs",
    "test:images:dom": "node tools/smoke-images.cjs --dom",
    "test:safety": "node tools/smoke-safety.cjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "oxfmt": "^0.77.0",
    "tailwindcss": "^4.3.5"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0"
  },
  "license": "MIT"
}
